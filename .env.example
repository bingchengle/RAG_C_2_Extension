# Rename this file to `.env` and fill in your keys.

# OpenAI-compatible chat/embedding endpoint
OPENAI_API_KEY=your_openai_key
OPENAI_BASE_URL=https://api.openai.com/v1

# BGE API endpoint (OpenAI-compatible embeddings + rerank endpoint)
BGE_API_KEY=your_bge_key
BGE_API_BASE_URL=https://api.siliconflow.cn/v1
BGE_RERANK_BASE_URL=https://api.siliconflow.cn/v1

# Optional model overrides
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
BGE_EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
BGE_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# Optional providers
GEMINI_API_KEY=your_gemini_key
IBM_API_KEY=your_ibm_key
JINA_API_KEY=your_jina_key
